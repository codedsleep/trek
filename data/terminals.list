# Terminal emulators trek knows how to drive, one per line:
#
#   program|arguments before a command|arguments that keep the window open
#
# The first installed entry is used when neither the "terminal" setting nor
# $TERMINAL names one. A terminal not listed here is given "-e" and no
# keep-open flag; trek then keeps the window open itself, without a shell.
foot|-e|--hold
kitty|-e|--hold
alacritty|-e|--hold
wezterm|start --|
ghostty|-e|--wait-after-command
ptyxis|--|
gnome-terminal|--|
konsole|-e|--hold
xfce4-terminal|-x|--hold
lxterminal|-e|
xterm|-e|-hold
